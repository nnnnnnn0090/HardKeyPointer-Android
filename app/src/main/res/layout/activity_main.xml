<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- App bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/app_name"
        app:titleCentered="true"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Service status -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/SettingLabel"
                            android:text="@string/service_status_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/serviceStatusLabel"
                            style="@style/ServiceStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/service_status_label_background"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/serviceStatusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openAccessibilitySettingsButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/open_accessibility_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pointer movement -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SectionHeader"
                        android:text="@string/section_pointer" />

                    <!-- Up -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/upKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/up_move_key_code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/upKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Down -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/downKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/down_move_key_code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/downKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Left -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/leftKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/left_move_key_code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/leftKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Right -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/rightKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/right_move_key_code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rightKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Tap -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/tapKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/tap_key_code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tapKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scroll -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SectionHeader"
                        android:text="@string/section_scroll" />

                    <!-- Scroll up -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/scrollupKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/scroll_up" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scrollupKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Scroll down -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/scrolldownKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/scroll_down" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scrolldownKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Scroll left -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/scrollleftKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/scroll_left" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scrollleftKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Scroll right -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/scrollrightKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/scroll_right" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scrollrightKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Zoom -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SectionHeader"
                        android:text="@string/section_zoom" />

                    <!-- Zoom in -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/zoomInKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/zoom_in" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/zoomInKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>

                    <!-- Zoom out -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/zoomOutKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/zoom_out" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/zoomOutKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pointer toggle -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SectionHeader"
                        android:text="@string/section_toggle" />

                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/disableKeyCodeLabel"
                            style="@style/SettingLabel"
                            android:text="@string/disable_key_code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/disableKeyCodeButton"
                            style="@style/SettingKeyButton"
                            android:text="@string/set_button" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SectionHeader"
                        android:text="@string/section_settings" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/coordinateModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pixelModeButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mode_pixels" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratioModeButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mode_ratio" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Move speed -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/moveSpeedLabel"
                            style="@style/SettingLabel"
                            android:text="@string/move_speed" />

                        <TextView
                            android:id="@+id/moveSpeedValue"
                            style="@style/SettingValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/moveSpeedSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:valueFrom="5"
                        android:valueTo="100"
                        android:stepSize="1"
                        android:value="30" />

                    <!-- Move acceleration -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            style="@style/SettingLabel"
                            android:text="@string/move_accel" />

                        <TextView
                            android:id="@+id/moveAccelValue"
                            style="@style/SettingValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/moveAccelSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:valueFrom="0"
                        android:valueTo="500"
                        android:stepSize="10"
                        android:value="100" />

                    <!-- Scroll distance -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/scrollDistanceLabel"
                            style="@style/SettingLabel"
                            android:text="@string/scroll_distance" />

                        <TextView
                            android:id="@+id/scrollDistanceValue"
                            style="@style/SettingValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/scrollDistanceSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:valueFrom="50"
                        android:valueTo="500"
                        android:stepSize="10"
                        android:value="200" />

                    <!-- Scroll speed -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            style="@style/SettingLabel"
                            android:text="@string/scroll_speed" />

                        <TextView
                            android:id="@+id/scrollSpeedValue"
                            style="@style/SettingValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/scrollSpeedSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:valueFrom="1"
                        android:valueTo="10"
                        android:stepSize="1"
                        android:value="8" />

                    <!-- Zoom amount -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            android:id="@+id/zoomAmountLabel"
                            style="@style/SettingLabel"
                            android:text="@string/zoom_amount" />

                        <TextView
                            android:id="@+id/zoomAmountValue"
                            style="@style/SettingValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/zoomAmountSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:valueFrom="1"
                        android:valueTo="10"
                        android:stepSize="1"
                        android:value="3" />

                    <!-- Zoom duration -->
                    <LinearLayout style="@style/SettingRow">

                        <TextView
                            style="@style/SettingLabel"
                            android:text="@string/zoom_duration" />

                        <TextView
                            android:id="@+id/zoomDurationValue"
                            style="@style/SettingValue" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/zoomDurationSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:valueFrom="100"
                        android:valueTo="1000"
                        android:stepSize="50"
                        android:value="300" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- License -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/license_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/license_button"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/creditTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credit"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
